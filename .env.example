# Clés des API OFFICIELLES de chaque fournisseur de modèles — serveur
# uniquement. Ne JAMAIS préfixer par NEXT_PUBLIC_ : elles ne doivent pas
# fuiter côté navigateur. Copier ce fichier vers .env.local et renseigner
# au moins UN fournisseur par fonctionnalité utilisée (le fallback bascule
# automatiquement sur les fournisseurs configurés — pas de vendor lock-in).

# Black Forest Labs — Flux Kontext Pro/Max, rendu image (https://dashboard.bfl.ai)
BFL_API_KEY=

# Google Gemini — Nano Banana / Nano Banana Pro, rendu image (https://aistudio.google.com/apikey)
GOOGLE_API_KEY=

# Kling (Kuaishou) — Kling 3 / 2.5 Turbo, vidéo (https://app.klingai.com,
# console développeur : SecretKey)
KLING_SECRET_KEY=

# Runway — Gen-4 Turbo, vidéo (https://dev.runwayml.com)
RUNWAY_API_KEY=

# OpenAI — GPT Image 1.5/1 (rendu image) + Sora 2/2 Pro (vidéo)
# (https://platform.openai.com/api-keys)
OPENAI_API_KEY=

# Magic Hour — plateforme AGRÉGATRICE (exception au principe "API officielles
# uniquement", voir AGENTS.md §1) : AI Image Editor (flux-2-klein épinglé —
# éligible au free tier) + Image-to-Video (routage `default`, ~ltx-2.3 en
# gratuit) (https://magichour.ai/developer?tab=api-keys)
MAGIC_HOUR_API_KEY=

# ComfyUI — serveur LOCAL de test (votre GPU, gratuit, hors-ligne) : img2img
# ET img2video (i2v) via l'API /prompt (https://docs.comfy.org).
# Image : COMFYUI_CHECKPOINT = nom exact du .safetensors dans
# models/checkpoints (requis pour l'image). Le graphe image par défaut vise
# les checkpoints SD1.5/SDXL ; pour Flux ou un graphe custom, exporter le
# workflow en format API et le pointer via COMFYUI_WORKFLOW_FILE.
# Vidéo (Animate) : pas de graphe par défaut — exporter votre workflow
# img2video (Wan 2.2, LTX-Video...) en format API et le pointer via
# COMFYUI_VIDEO_WORKFLOW_FILE (requis pour la vidéo) ; sortie mp4 attendue
# (ex. VHS_VideoCombine de ComfyUI-VideoHelperSuite). COMFYUI_VIDEO_FPS doit
# correspondre au frame_rate du graphe (16 = Wan, 24/25 = LTX ; défaut 16).
# Placeholders (quotes incluses) : "{{PROMPT}}", "{{NEGATIVE}}", "{{IMAGE}}",
# "{{SEED}}" + vidéo : "{{FRAMES}}" (= durée x fps), "{{FPS}}", "{{WIDTH}}",
# "{{HEIGHT}}".
COMFYUI_CHECKPOINT=
# COMFYUI_BASE_URL=http://127.0.0.1:8188
# COMFYUI_DENOISE=0.55
# COMFYUI_WORKFLOW_FILE=
# COMFYUI_VIDEO_WORKFLOW_FILE=
# COMFYUI_VIDEO_FPS=16
